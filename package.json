{
  "name": "website-blocker",
  "version": "1.0.1",
  "private": true,
  "description": "Chrome extension that blocks distracting websites. No tracking, no network calls, no accounts.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "vite build && node scripts/inject-test-key.mjs",
    "lint": "biome ci . && tsc --noEmit",
    "format": "biome check --write .",
    "test:unit": "vitest run",
    "test:e2e": "pnpm build:e2e && playwright test",
    "test:e2e:headed": "pnpm build:e2e && HEADED=1 playwright test",
    "test:e2e:xvfb": "pnpm build:e2e && xvfb-run -a --server-args=\"-screen 0 1280x800x24\" env HEADED=1 playwright test",
    "test": "pnpm test:unit && pnpm test:e2e",
    "package": "pnpm build && node scripts/package.mjs",
    "check:version": "node scripts/check-version.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "release:bump": "node scripts/bump-version.mjs",
    "store:assets": "./store/make-store-assets.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.9",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "chrome-types": "^0.1.446",
    "tailwindcss": "^4.1.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4"
  }
}
