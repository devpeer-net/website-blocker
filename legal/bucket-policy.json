{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadPrivacyPolicy",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::website-blocker-extension/privacy.html"
    },
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::website-blocker-extension",
        "arn:aws:s3:::website-blocker-extension/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
